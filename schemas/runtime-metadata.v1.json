{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/animu-sphere/usd-geospatial-runtime/schemas/runtime-metadata.v1.json",
  "title": "Runtime metadata",
  "description": "Machine-readable description of one composed runtime target. Generated from the composition manifest, its lock, and the accepted release evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "generated_by", "runtime", "target", "identity", "components", "capabilities", "evidence"],
  "properties": {
    "schema": {"const": "usd-geospatial-runtime.runtime-metadata/v1"},
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "inputs"],
      "properties": {
        "tool": {"type": "string", "minLength": 1},
        "inputs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["manifest", "lock", "evidence"],
          "properties": {
            "manifest": {"$ref": "#/$defs/repositoryPath"},
            "lock": {"$ref": "#/$defs/repositoryPath"},
            "evidence": {"$ref": "#/$defs/repositoryPath"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "release"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "release": {"$ref": "#/$defs/release"}
      }
    },
    "target": {
      "type": "object",
      "description": "Canonical target identity. The id is the composition target string; every other field is derived from it or from the resolved composition.",
      "additionalProperties": false,
      "required": ["id", "os", "arch", "toolchain", "host_abi", "usd_version", "host_python"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+-[a-z0-9_]+-[a-z0-9]+-py[0-9]{2,3}$"},
        "os": {"enum": ["windows", "linux", "macos"]},
        "arch": {"enum": ["x86_64", "arm64"]},
        "toolchain": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
        "host_abi": {"type": "string", "pattern": "^py[0-9]{2,3}$"},
        "usd_version": {"type": "string", "minLength": 1},
        "host_python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "bundled"],
          "properties": {
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
            "bundled": {"type": "boolean"}
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "description": "Immutable identities of the locked composition and of the published composed artifact.",
      "additionalProperties": false,
      "required": ["manifest_digest", "composition_digest", "runtime_digest", "composed_artifact", "composed_oci_manifest", "oci_locator"],
      "properties": {
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "composition_digest": {"$ref": "#/$defs/digest"},
        "runtime_digest": {"$ref": "#/$defs/digest"},
        "composed_artifact": {"$ref": "#/$defs/digest"},
        "composed_oci_manifest": {"$ref": "#/$defs/digest"},
        "oci_locator": {"type": "string", "pattern": "^oci://[^@]+@sha256:[0-9a-f]{64}$"}
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version", "artifact", "oci_manifest"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["runtime", "library", "plugin"]},
          "version": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/digest"},
          "oci_manifest": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "required", "component", "version", "artifact"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "required": {
            "type": "boolean",
            "description": "True when the composition manifest requests the capability directly; false when it is satisfied only to close a dependency."
          },
          "requirement": {
            "type": "string",
            "description": "Version constraint from the manifest requirement, when the manifest states one."
          },
          "component": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["release", "status", "evidence_file", "release_record"],
      "properties": {
        "release": {"$ref": "#/$defs/release"},
        "status": {"enum": ["passed", "failed"]},
        "evidence_file": {"$ref": "#/$defs/repositoryPath"},
        "release_record": {"$ref": "#/$defs/repositoryPath"}
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "release": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "repositoryPath": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"}
  }
}
