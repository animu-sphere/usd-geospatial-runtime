{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/animu-sphere/usd-geospatial-runtime/schemas/acceptance-report.v1.json",
  "title": "Acceptance report",
  "description": "Generated summary written by tools/accept.py for one composed runtime prefix. It is acceptance output, not a release record; release evidence is derived from it after the published artifact has also been pulled, verified, and reconstructed.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "contract", "runtime_digest", "status", "complete", "required_checks", "checks"],
  "properties": {
    "schema": {"const": 1},
    "contract": {"const": "usd-geospatial-runtime.acceptance/v1"},
    "runtime_digest": {"$ref": "#/$defs/digest"},
    "target": {"type": "string", "minLength": 1},
    "status": {"$ref": "#/$defs/status"},
    "complete": {
      "type": "boolean",
      "description": "True only when every required check ran and passed."
    },
    "required_checks": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "checks": {
      "type": "object",
      "description": "One entry per check that ran, in execution order.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["status"],
        "properties": {
          "status": {"$ref": "#/$defs/status"},
          "exit_code": {"type": "integer"},
          "output": {"type": "string", "minLength": 1},
          "verification": {
            "$ref": "#/$defs/status",
            "description": "Result of the derived verification applied to a probe's output, when the check has one. A probe can exit zero and still fail its verification."
          }
        }
      }
    },
    "error": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"enum": ["passed", "failed"]}
  }
}
