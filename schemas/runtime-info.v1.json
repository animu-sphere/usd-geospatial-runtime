{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/animu-sphere/usd-geospatial-runtime/schemas/runtime-info.v1.json",
  "title": "Runtime info",
  "description": "What the SDK reports about the runtime it found. Produced by usd_geospatial::runtime_info() from a materialized prefix, so it describes the runtime that is present rather than the one a build was configured against. It is the introspection subset of runtime metadata: the same field names, without the release and distribution facts that only the repository knows.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "runtime", "target", "identity", "components", "capabilities"],
  "properties": {
    "schema": {"const": "usd-geospatial-runtime.runtime-info/v1"},
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "description": "Canonical target identity, decomposed from the target string in the composition lock. The fields match schemas/runtime-metadata.v1.json so a caller can compare a loaded runtime against a released one field by field.",
      "additionalProperties": false,
      "required": ["id", "os", "arch", "toolchain", "host_abi", "usd_version", "host_python"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+-[a-z0-9_]+-[a-z0-9]+-py[0-9]{2,3}$"},
        "os": {"enum": ["windows", "linux", "macos"]},
        "arch": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "toolchain": {"type": "string", "pattern": "^[a-z][a-z0-9]*$"},
        "host_abi": {"type": "string", "pattern": "^py[0-9]{2,3}$"},
        "usd_version": {"type": "string", "minLength": 1},
        "host_python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version", "bundled"],
          "properties": {
            "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
            "bundled": {"type": "boolean"}
          }
        }
      }
    },
    "identity": {
      "type": "object",
      "description": "Immutable identities read from the prefix's own composition lock. runtime_digest is what a caller compares against a release record to prove which runtime is loaded.",
      "additionalProperties": false,
      "required": ["manifest_digest", "composition_digest", "runtime_digest"],
      "properties": {
        "manifest_digest": {"$ref": "#/$defs/digest"},
        "composition_digest": {"$ref": "#/$defs/digest"},
        "runtime_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "components": {
      "type": "array",
      "description": "Resolved components, sorted by id so equal runtimes serialize to equal text.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "version", "artifact"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"enum": ["runtime", "library", "plugin"]},
          "version": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/digest"}
        }
      }
    },
    "capabilities": {
      "type": "array",
      "description": "Capability to provider mapping, sorted by capability. There is no 'required' flag here: a materialized prefix records what was resolved, not which requirements the manifest stated.",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["capability", "component", "version", "artifact"],
        "properties": {
          "capability": {"type": "string", "minLength": 1},
          "component": {"type": "string", "minLength": 1},
          "version": {"type": "string", "minLength": 1},
          "artifact": {"$ref": "#/$defs/digest"}
        }
      }
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
